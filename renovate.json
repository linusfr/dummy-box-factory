{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": [
		"config:recommended",
		":semanticCommits",
		":prHourlyLimitNone"
	],
	"labels": [
		"renovate"
	],
	"pre-commit": {
		"enabled": true
	},
	"customManagers": [
		{
			"customType": "regex",
			"fileMatch": [
				"^\\.github/workflows/.+\\.ya?ml$"
			],
			"matchStrings": [
				"# renovate: datasource=(?<datasource>[\\w-]+) depName=(?<depName>[\\S]+)\\n\\s+\\w+: \"(?<currentValue>[^\"]+)\""
			],
			"versioningTemplate": "semver"
		}
	],
	"pruneStaleBranches": true
}
